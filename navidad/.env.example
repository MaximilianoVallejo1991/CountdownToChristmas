# Copiá este archivo a .env y completá con tu propia key.
# Conseguila gratis en https://restcountries.com/sign-up (free: 500 req/mes).
# Después agregá "localhost" y tu dominio de producción a la whitelist de
# hostnames de la key (CORS) en el dashboard de restcountries.com.
VITE_RESTCOUNTRIES_API_KEY=tu_api_key_aca
